{
  "name": "casino-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run generate:api && tsc -b && vite build",
    "preview": "vite preview",
    "generate:api": "openapi-typescript contracts/player-v1.yaml -o src/types/api.generated.ts",
    "i18n:extract": "npx --yes tsx scripts/extract-i18n-phrases.mjs",
    "i18n:locales": "npx --yes tsx scripts/generate-i18n-locales.mjs",
    "i18n:locales:force": "npx --yes tsx scripts/generate-i18n-locales.mjs --force",
    "i18n:rebuild": "npx --yes tsx scripts/rebuild-i18n-from-maps.mjs",
    "sync:platform-languages": "node scripts/sync-platform-languages.mjs",
    "sync:contract": "echo Update contracts/player-v1.yaml from https://github.com/cr4all/casino-api-contract tags",
    "test": "vitest run"
  },
  "dependencies": {
    "@fingerprintjs/fingerprintjs": "^5.2.0",
    "@fontsource/roboto": "^5.2.10",
    "@fontsource/roboto-condensed": "^5.2.8",
    "@marsidev/react-turnstile": "^1.5.3",
    "axios": "^1.9.0",
    "framer-motion": "^12.15.0",
    "laravel-echo": "^2.3.7",
    "pusher-js": "^8.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-qr-code": "^2.2.0",
    "react-router-dom": "^7.6.0",
    "swiper": "^11.2.8",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.8",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "@vitalets/google-translate-api": "^9.2.1",
    "@vitejs/plugin-react": "^4.5.0",
    "openapi-typescript": "^7.8.0",
    "sharp": "^0.35.1",
    "tailwindcss": "^4.1.8",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
