# Copy to `.env.mobile` and adjust before running `npm run mobile:build`.
# Vite loads this file when building with `--mode mobile`.
#
# Native WebViews use hostname `localhost`, so API/Reverb hosts cannot be
# derived from the page domain — set them explicitly here.

# Pastebin account that owns the latest API-endpoint paste (JSON).
# api_user_key is returned by POST https://pastebin.com/api/api_login.php.
# Leave both blank to keep the build-time API URL below.
# The installed app version compared with the server comes from package.json.
VITE_PASTEBIN_API_DEV_KEY=
VITE_PASTEBIN_API_USER_KEY=

# Production player API (required). Used when Pastebin has no usable paste.
VITE_API_URL=https://api.ibets24.com/api/v1

# Laravel Reverb / WebSocket (required for live balance)
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=api.ibets24.com
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https

# Optional integrations (same as website)
VITE_TAWK_PROPERTY_ID=
VITE_TAWK_WIDGET_ID=
VITE_TURNSTILE_SITE_KEY=
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=mobile
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com
VITE_MARKETING_PIXEL_ID=
VITE_MARKETING_PIXEL_SRC=
# Game thumbnails and provider art (casino-assets). Not served by the API host.
VITE_ASSETS_BASE_URL=https://image.ibets24.com
