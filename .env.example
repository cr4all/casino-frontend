# Backend API URL — used for local/dev and direct IP access.
# Production (real domains): browser uses https://api.{hostname}/api/v1 automatically.
VITE_API_URL=http://localhost:8000/api/v1

# Laravel Reverb (WebSocket realtime balance) — production derives host/port/scheme from page URL.
VITE_REVERB_APP_KEY=casino-local-key
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

# tawk.to live chat (Dashboard → Administration → Chat Widget → Direct Chat Link)
VITE_TAWK_PROPERTY_ID=
VITE_TAWK_WIDGET_ID=

# Cloudflare Turnstile (shown after RISK_CHALLENGE from AFS)
VITE_TURNSTILE_SITE_KEY=

# Sentry (leave DSN empty locally to disable)
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# PostHog Cloud (leave KEY empty locally to disable; loads only after analytics cookie consent)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Marketing / affiliate conversion pixel (prdredir). Loads only after the visitor
# accepts the "marketing" cookie category. Defaults to the partner-provided tag;
# set VITE_MARKETING_PIXEL_SRC empty to disable the pixel entirely.
VITE_MARKETING_PIXEL_ID=pix_ibets24
VITE_MARKETING_PIXEL_SRC=https://scripts.prdredir.com/scripts/pix_ibets24.js

# Build-time only (source map upload — not exposed to the browser)
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
