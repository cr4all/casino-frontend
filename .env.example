# Backend API URL (port must match server API_PORT in /opt/casino/.env)
VITE_API_URL=http://10.10.51.60:8000/api/v1

# Laravel Reverb (WebSocket realtime balance)
VITE_REVERB_APP_KEY=casino-local-key
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

# tawk.to live chat (Dashboard → Administration → Chat Widget → Direct Chat Link)
VITE_TAWK_PROPERTY_ID=
VITE_TAWK_WIDGET_ID=

# Cloudflare Turnstile (shown after RISK_CHALLENGE from AFS)
VITE_TURNSTILE_SITE_KEY=
